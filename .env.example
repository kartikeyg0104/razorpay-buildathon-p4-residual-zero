# Copy to .env and fill in. .env is gitignored; never commit a real key or a real database
# URL. Nothing in this file has a default that is safe to deploy — RZ_ENV=production
# refuses to start until the required values are actually set.

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================

# local | production
#   local      — no login, single tenant, the committed synthetic dev corpus, SQLite.
#                This is what `make demo`, `make eval` and the test suite run on.
#   production — every route needs a credential, every request is confined to one
#                organisation, and PostgreSQL is the authoritative store.
RZ_ENV=local

# off | required
# `required` turns on authentication and per-organisation isolation. RZ_ENV=production
# refuses to boot unless this is `required`: a public deployment serving financial data
# with authentication off is the failure this check exists to prevent.
RZ_AUTH_MODE=off

# Session signing/entropy secret. 32+ characters, required in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RZ_SESSION_SECRET=

# The public HTTPS origin, no trailing slash. This is the CORS origin, the cookie scope,
# the write-origin allowlist and the HTTPS redirect target. Must be https:// in production.
RZ_PUBLIC_ORIGIN=

# Extra browser origins allowed to read the API and make writes (comma-separated).
RZ_ALLOWED_ORIGINS=

# Chrome extension ids allowed as CORS origins (comma-separated, no scheme). Only needed if
# an extension page must READ a cross-origin response; the extension's own API calls use a
# bearer token and do not need this.
RZ_EXTENSION_IDS=

# 1 when a TLS-terminating proxy is in front (Fly, Railway, Render, nginx, Cloudflare).
# Lets the app trust X-Forwarded-Proto/For. Defaults to 1 in production, 0 locally.
RZ_TRUST_PROXY=

# 1 to allow self-service signup (each signup creates its own empty organisation).
# Set 0 for a closed demo where accounts are created by an administrator.
RZ_ALLOW_SIGNUP=1

# Session lifetime in hours. Default 12, capped at 720.
RZ_SESSION_TTL_HOURS=12

# Bind address and port. A container needs 0.0.0.0; most platforms inject PORT.
RZ_HOST=127.0.0.1
RZ_PORT=8765

# DEBUG | INFO | WARNING | ERROR. Logs are one JSON object per line and are scrubbed of
# anything credential-shaped before they are written.
RZ_LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================

# Unset (or sqlite://) means SQLite: local development, the CLI, the eval harness, tests.
# A postgresql:// URL makes PostgreSQL the authoritative store, which production requires.
#   RZ_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
RZ_DATABASE_URL=

# Postgres schema holding the cross-organisation identity tables. Default rz_shared.
RZ_SHARED_SCHEMA=rz_shared

# Directory for per-organisation SQLite files in local multi-tenant mode.
RZ_TENANT_ROOT=var/tenants

# Where the semantic (LLM) cache is written. The committed default lives under data/,
# which a container image ships read-only to the service account, so a deployment points
# this at its writable volume. A cache is per-container and disposable: moving it cannot
# change a reconciliation result.
RZ_LLM_CACHE_DIR=

# SQLite identity database (users, organisations, sessions, tokens) for local multi-tenant
# mode. Ignored when RZ_DATABASE_URL names PostgreSQL, where identity lives in
# RZ_SHARED_SCHEMA. Defaults to <RZ_TENANT_ROOT>/identity.sqlite.
RZ_IDENTITY_DB=

# Single-tenant SQLite ledger override, used by the CLI and the eval harness.
# RZ_DB=artifacts/dev/ledger.sqlite

# ============================================================================
# TEST HYGIENE (optional; unset in normal use)
# ============================================================================
# 1 makes the E2E suite refresh the committed documentation screenshots in
# artifacts/demo/ instead of writing to the gitignored artifacts/e2e/shots/.
# Leave unset so running tests never dirties the working tree.
RZ_REFRESH_DEMO_SHOTS=

# ============================================================================
# AI PROVIDER  (server-side only — no key ever reaches the browser or the extension)
# ============================================================================
# The provider is used only to rephrase deterministic facts and to suggest the next
# read-only tool. It is never financial authority and can never clear a transaction.

# nvidia | stub   (stub/off/none/fallback disable live calls entirely)
# NVIDIA NIM is the only supported live provider. Groq was removed on 2026-09-03.
# Any other value resolves to no endpoint and makes no call.
AI_PROVIDER=nvidia

# NVIDIA NIM (https://integrate.api.nvidia.com/v1) — key starts with nvapi-
NVIDIA_API_KEY=

# Model for the selected provider.
AI_MODEL=openai/gpt-oss-20b

# Generic fallback key, used when NVIDIA_API_KEY is empty.
AI_API_KEY=

# Seconds allowed for ONE provider call, capped at 120. Default 30.
AI_TIMEOUT_S=30

# Seconds allowed for ALL provider calls in one request, capped at 300. Default 40.
# One /ask can make up to four calls in series (three next-tool picks + one explanation),
# so this — not AI_TIMEOUT_S — is what bounds how long a request can take. When it runs
# out the remaining calls are skipped and the deterministic templates stand.
AI_TOTAL_BUDGET_S=40

# Extra completion tokens so hidden reasoning does not truncate the payload. Default 1200
# on NVIDIA NIM, capped at 4000.
AI_REASONING_HEADROOM=

# Kill switch: RZ_LLM=0 disables every live call. RZ_LLM_TEST=1 allows them under pytest.
