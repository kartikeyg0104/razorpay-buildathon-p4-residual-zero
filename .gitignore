# Data: gitignored except manifests, seeds, and the frozen Phase 1 *dev* corpus.
# Dev rendered views + truth.jsonl are committed so `make demo` / `make eval` work
# from a clean clone (NN-14). Regenerating them does not reproduce the tagged numbers.
# The test split stays gitignored; it is spent once (`artifacts/test/`).
data/**
!data/**/
!data/.gitkeep
!data/**/manifest.json
!data/seeds/
!data/seeds/**
!data/dev/rendered/
!data/dev/rendered/**
!data/dev/truth.jsonl

# artifacts/ is COMMITTED on purpose (§10) — do not ignore it.
*.sqlite-wal
*.sqlite-shm

__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.hypothesis/
.DS_Store
*.egg-info/
